// A floor of hexagons rushing towards the camera, with a glowing horizon.
uniform float3 iResolution;
uniform float iTime;
uniform float uSpeed;
uniform float uHorizon;
uniform float uBright;
uniform float4 uInk;
uniform float4 uHot;

float hexEdge(float2 p) {
    float2 r = float2(1.0, 1.7320508);
    float2 h = r * 0.5;
    float2 a = mod(p, r) - h;
    float2 b = mod(p - h, r) - h;
    float2 g = dot(a, a) < dot(b, b) ? a : b;
    float2 q = abs(g);
    return 0.5 - max(dot(q, normalize(float2(1.0, 1.7320508))), q.x);
}

half4 main(float2 coord) {
    float2 uv = coord / iResolution.xy;
    float y = uv.y - uHorizon;
    float3 col = float3(0.0);
    float a = 0.0;
    if (y > 0.002) {
        float z = 0.35 / y;
        float x = (uv.x - 0.5) * z * (iResolution.x / iResolution.y) * 2.2;
        float zz = z * 2.0 + iTime * uSpeed;
        float d = hexEdge(float2(x, zz) * 0.9);
        float wdt = 0.02 * z + 0.006;
        float l = (1.0 - smoothstep(0.0, wdt, d)) * exp(-z * 0.12);
        float fade = smoothstep(0.0, 0.15, y);
        col = mix(uHot.rgb, uInk.rgb, smoothstep(0.0, 0.5, y)) * l * fade;
        a = l * fade;
    }
    float hz = exp(-abs(y) * 60.0) * 0.8 + exp(-abs(y) * 8.0) * 0.18;
    col += uHot.rgb * hz;
    a = clamp(a + hz, 0.0, 1.0);
    return half4(half3(col * uBright), a * uBright);
}
