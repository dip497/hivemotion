// The ground every scene stands on: contour lines of a slow height field, a faint honeycomb
// over it, and a warm well where the eye should go. Lines keep a one pixel width.
uniform float3 iResolution;
uniform float iTime;
uniform float2 uWell;      // well position, 0..1 of the screen
uniform float uDepth;
uniform float uDensity;    // contour lines per unit of height
uniform float uBright;
uniform float uComb;       // honeycomb strength
uniform float4 uInk;
uniform float4 uHot;

float hash(float2 p) {
    float3 p3 = fract(float3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}
float noise(float2 p) {
    float2 i = floor(p); float2 f = fract(p);
    float2 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(hash(i), hash(i + float2(1, 0)), u.x), mix(hash(i + float2(0, 1)), hash(i + float2(1, 1)), u.x), u.y);
}
float fbm(float2 p) {
    float v = 0.0; float a = 0.5;
    for (int i = 0; i < 4; i++) { v += a * noise(p); p = p * 2.02 + float2(11.0, 7.0); a *= 0.5; }
    return v;
}
float height(float2 p, float t) {
    float2 w = uWell * float2(iResolution.x / iResolution.y, 1.0);
    float2 d = p - w;
    float r2 = dot(d, d);
    float well = -uDepth / (1.0 + r2 * 18.0);
    return fbm(p * 1.3 + float2(t * 0.02, -t * 0.012)) * 0.55 + well;
}
// distance to the nearest edge of a pointy-top hex cell of size s
float hexEdge(float2 p, float s) {
    float2 r = float2(1.0, 1.7320508);
    float2 h = r * 0.5;
    float2 a = mod(p / s, r) - h;
    float2 b = mod(p / s - h, r) - h;
    float2 g = dot(a, a) < dot(b, b) ? a : b;
    float2 q = abs(g);
    float d = max(dot(q, normalize(float2(1.0, 1.7320508))), q.x);
    return (0.5 - d) * s;
}
half4 main(float2 coord) {
    float2 p = coord / iResolution.y;
    float t = iTime;
    float e = 1.0 / iResolution.y;
    float h = height(p, t);
    float hx = height(p + float2(e, 0.0), t);
    float hy = height(p + float2(0.0, e), t);
    float grad = length(float2(hx - h, hy - h)) * uDensity + 1e-5;
    float f = abs(fract(h * uDensity) - 0.5);
    float line = 1.0 - smoothstep(0.6, 1.6, f / grad);
    float major = abs(fract(h * uDensity / 5.0) - 0.5);
    float lineMajor = 1.0 - smoothstep(0.6, 2.2, major / (grad / 5.0));
    float2 w = uWell * float2(iResolution.x / iResolution.y, 1.0);
    float hot = exp(-dot(p - w, p - w) * 9.0);
    float comb = 1.0 - smoothstep(0.0, 1.2 * e, hexEdge(coord / iResolution.y + float2(0.0, t * 0.004), 0.085));
    float3 col = mix(uInk.rgb, uHot.rgb, clamp(hot * 1.6, 0.0, 1.0));
    float a = clamp((line * 0.45 + lineMajor * 0.55) * uBright * (0.35 + hot * 1.4), 0.0, 1.0);
    a = max(a, comb * uComb * (0.25 + hot * 0.9));
    float3 glow = uHot.rgb * hot * 0.16 * uBright;
    float3 c = col * a + glow;
    return half4(half3(c), clamp(a + hot * 0.16 * uBright, 0.0, 1.0));
}
